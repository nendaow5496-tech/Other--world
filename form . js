const API = "https://script.google.com/macros/s/AKfycbzV-CRY4SYgzo-xUXYOp3AMQpf3PRTAXfHQ4eW54csBvYrEwhk2kpaVIT/exec";

function sendForm(formType, data, form) {
  const btn = form.querySelector("button");
  btn.disabled = true;
  btn.textContent = "กำลังส่ง...";

  fetch(API, {
    method: "POST",
    mode: "cors",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify(Object.assign({ formType: formType }, data))
  })
  .then(function(res) {
    alert("ส่งเรียบร้อยแล้ว ✅");
    form.reset();
    btn.disabled = false;
    btn.textContent = "ส่งข้อมูล";
  })
  .catch(function(err) {
    alert("ส่งไม่สำเร็จ ลองใหม่อีกครั้ง ❌");
    btn.disabled = false;
    btn.textContent = "ส่งข้อมูล";
  });
}
